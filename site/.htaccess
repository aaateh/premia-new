# Суровая премия — самостоятельный сайт.
# Этот файл рассчитан на размещение сборки в корне домена (public_html).

DirectoryIndex index.html
Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Красивые адреса документов: /docs/oferta, /docs/privacy, /docs/consent
    # (и те же адреса с .pdf на конце).
    RewriteRule ^docs/(oferta|privacy|consent)(?:\.pdf)?/?$ docs/index.php?doc=$1 [L,NC,QSA]

    # PHP выполняется только в обработчике формы и в редиректах документов.
    RewriteRule ^(?:mail/mail_partners|docs/(?:index|oferta/index|privacy/index|consent/index))\.php$ - [L]
    RewriteRule \.php$ - [F,L,NC]
</IfModule>

# Секреты, служебные тексты и исходники формы не отдаём напрямую.
<FilesMatch "^(?:config(?:\.local)?\.php|.*\.(?:md|log|ini|env))$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set X-Frame-Options "SAMEORIGIN"

    # Политика безопасности. Если на хостинге CSP уже задан в общем конфиге,
    # этот блок можно убрать, чтобы заголовки не дублировались.
    Header always set Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; img-src 'self' data: https://smartcaptcha.yandexcloud.net https://smartcaptcha.cloud.yandex.ru; font-src 'self'; media-src 'self' blob:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline' https://smartcaptcha.yandexcloud.net https://smartcaptcha.cloud.yandex.ru; connect-src 'self' https://smartcaptcha.yandexcloud.net https://smartcaptcha.cloud.yandex.ru; frame-src https://smartcaptcha.yandexcloud.net https://smartcaptcha.cloud.yandex.ru; form-action 'self'"
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 7 days"
    ExpiresByType application/javascript "access plus 7 days"
    ExpiresByType image/jpeg "access plus 30 days"
    ExpiresByType image/png "access plus 30 days"
    ExpiresByType image/webp "access plus 30 days"
    ExpiresByType image/svg+xml "access plus 30 days"
    ExpiresByType font/woff2 "access plus 30 days"
    ExpiresByType video/mp4 "access plus 30 days"
</IfModule>

<IfModule mod_mime.c>
    AddType font/woff2 .woff2
    AddType image/webp .webp
    AddType video/mp4 .mp4
</IfModule>
